# Keep build context small and free of local build output, dependencies, and secrets.
.git/
.github/

# Java build output
target/
**/target/
*.jar
*.war

# Node build output and dependencies
node_modules/
**/node_modules/
dist/
**/dist/
coverage/
*.tsbuildinfo

# Local runtime data and generated artifacts
.shutdown-tracker/
local-data/
uploads/
exports/
logs/
*.log

# Environment and secrets
.env
.env.*
*.pem
*.key
*.p12
*.jks

# IDE and editor files
.idea/
.vscode/
*.iml
.DS_Store
