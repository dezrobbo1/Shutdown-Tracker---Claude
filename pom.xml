<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.0</version>
        <relativePath/>
    </parent>

    <groupId>com.shutdowntracker</groupId>
    <artifactId>shutdown-tracker</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Shutdown Tracker</name>
    <description>Shutdown Tracker backend services</description>

    <modules>
        <module>packages/project-import-contract</module>
        <module>packages/project-export-contract</module>
        <module>services/api</module>
        <module>services/project-worker</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <mpxj.version>16.4.0</mpxj.version>
        <!-- Runs a real PostgreSQL binary in tests without requiring Docker, so the
             JDBC repositories and Flyway migrations are exercised against the actual
             database engine in both local builds and CI. -->
        <embedded-postgres.version>2.0.7</embedded-postgres.version>
        <embedded-postgres-binaries.version>16.2.0</embedded-postgres-binaries.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.zonky.test.postgres</groupId>
                <artifactId>embedded-postgres-binaries-bom</artifactId>
                <version>${embedded-postgres-binaries.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
